# Docker Compose interpolation only. Generate separate random values with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDAGENT_API_KEYS={"replace-with-a-random-api-key-at-least-32-chars":"user-a"}
CLOUDAGENT_LLM_API_KEY=replace-with-your-provider-key
CLOUDAGENT_LLM_BASE_URL=https://api.openai.com/v1
OPENSANDBOX_SERVER_API_KEY=replace-with-a-random-opensandbox-key-at-least-32-chars
CLOUDAGENT_SANDBOX_IMAGE=python:3.12-slim
CLOUDAGENT_SANDBOX_TTL_SECONDS=600
CLOUDAGENT_SANDBOX_CPU=1
CLOUDAGENT_SANDBOX_MEMORY=512Mi
