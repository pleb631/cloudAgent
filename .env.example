# Docker Compose interpolation only. Generate separate random values with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDAGENT_API_KEYS={"replace-with-a-random-api-key-at-least-32-chars":"user-a"}
CLOUDAGENT_LLM_API_KEY=replace-with-your-provider-key
CLOUDAGENT_LLM_BASE_URL=https://api.openai.com/v1
OPENSANDBOX_SERVER_API_KEY=replace-with-a-random-opensandbox-key-at-least-32-chars
CLOUDAGENT_SANDBOX_IMAGE=python:3.12-slim
CLOUDAGENT_SANDBOX_TTL_SECONDS=600
CLOUDAGENT_SANDBOX_CPU=1
CLOUDAGENT_SANDBOX_MEMORY=512Mi

# Counts are per Agent process. Keep one worker and size the host before raising them.
# See docs/resource-capacity.md for sidecar overhead and disk/aggregate budget limits.
CLOUDAGENT_MAX_SANDBOX_SESSIONS=4
CLOUDAGENT_MAX_SANDBOX_SESSIONS_PER_TENANT=2
CLOUDAGENT_MAX_CONCURRENT_RUNS=20
CLOUDAGENT_MAX_RUNS_PER_TENANT=4
CLOUDAGENT_MAX_CONCURRENT_MODEL_CALLS=8
CLOUDAGENT_MAX_MODEL_CALLS_PER_TENANT=4
CLOUDAGENT_MAX_MODEL_CALLS_PER_RUN=64
CLOUDAGENT_MAX_SUBAGENT_INVOCATIONS_PER_RUN=32
CLOUDAGENT_REQUEST_TIMEOUT=120
CLOUDAGENT_RUN_TIMEOUT=300
CLOUDAGENT_MAX_REQUEST_BYTES=1048576
