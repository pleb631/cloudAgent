# Generate independent random values: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDAGENT_API_KEYS={"replace-with-a-random-api-key-at-least-24-chars":"user-a"}
CLOUDAGENT_LLM_API_KEY=replace-with-your-provider-key
CLOUDAGENT_LLM_BASE_URL=https://api.openai.com/v1
CLOUDAGENT_AGENTS_DIR=agents
CLOUDAGENT_SANDBOX_URL=http://127.0.0.1:8001
CLOUDAGENT_SANDBOX_TOKEN=replace-with-shared-random-manager-token
CLOUDAGENT_MAX_CONCURRENT_RUNS=20
CLOUDAGENT_MAX_RUNS_PER_TENANT=4
CLOUDAGENT_RUN_TIMEOUT=300
