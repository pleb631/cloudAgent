# Copy to repository root .env; from repository root: docker compose --profile image build && docker compose up -d openhands-api
CLOUDAGENT_OH_API_KEYS={"replace-with-random-key-at-least-24-characters":"demo"}
CLOUDAGENT_OH_LLM_API_KEY=replace-with-provider-key
# Reachable FROM agent-server Docker containers, not controller-local localhost.
CLOUDAGENT_OH_LLM_BASE_URL=https://api.openai.com/v1
# Existing absolute path ON DOCKER HOST. Must not be a symlink.
CLOUDAGENT_OH_HOST_DATA_ROOT=/srv/cloudagent-data
CLOUDAGENT_OH_WORKSPACE_ROOTS={"demo":"/srv/cloudagent-data/demo"}
CLOUDAGENT_OH_SERVER_IMAGE=cloudagent-openhands-server:1.62.0
CLOUDAGENT_OH_MAX_CONCURRENT_RUNS=4
CLOUDAGENT_OH_RUN_TIMEOUT=300
CLOUDAGENT_OH_REQUEST_TIMEOUT=60
CLOUDAGENT_OH_MAX_REQUEST_BYTES=1048576
CLOUDAGENT_OH_MAX_OUTPUT_BYTES=1048576
CLOUDAGENT_OH_SANDBOX_MEMORY=1g
CLOUDAGENT_OH_SANDBOX_CPUS=1
CLOUDAGENT_OH_SANDBOX_PIDS=256
CLOUDAGENT_OH_DEPLOYMENT_ID=cloudagent-oh
