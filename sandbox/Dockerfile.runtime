FROM python:3.12-slim
RUN groupadd --gid 10001 sandbox && useradd --uid 10001 --gid 10001 --no-create-home sandbox && mkdir /workspace && chown 10001:10001 /workspace
COPY src/sandbox_service /opt/sandbox_service
ENV PYTHONPATH=/opt PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
WORKDIR /workspace
VOLUME ["/workspace"]
